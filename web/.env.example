# Public site URL (used for canonical URLs and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fallback site name, used only if no business name is set in the CMS
NEXT_PUBLIC_SITE_NAME=My Site

# Sanity project (must match cms/.env — use "production" dataset for builds)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
