---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** File name in src/assets/screenshots without extension. */
	name: string;
	alt: string;
	caption?: string;
}

const { name, alt, caption } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', {
	eager: true,
});
const image = images[`../assets/screenshots/${name}.png`]?.default;
---

<figure class="screenshot">
	{
		image ? (
			<a href={image.src} target="_blank" rel="noopener" title="In voller Größe öffnen">
				<Image src={image} alt={alt} />
			</a>
		) : (
			<div class="screenshot-missing" role="img" aria-label={alt}>
				<span>Screenshot folgt</span>
				<code>{name}.png</code>
			</div>
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>
